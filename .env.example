# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# Both are SERVER-ONLY. Do not add a NEXT_PUBLIC_ prefix to either:
# anything NEXT_PUBLIC_ is inlined into the browser bundle.

SUPABASE_URL=

# Supabase dashboard -> Settings -> API Keys.
# Use a secret key (sb_secret_...). The legacy service_role JWT also works but
# is deprecated. NOT the publishable / anon key: with RLS on and no policies it
# can do nothing.
SUPABASE_SECRET_KEY=

# Phase 3 only, not needed yet:
# GEMINI_API_KEY=
